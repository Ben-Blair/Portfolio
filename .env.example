# The hero chat. Without this the site works fine — the input just renders an
# "offline, email me instead" state. Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Used for absolute URLs in metadata, sitemap.xml, and robots.txt.
# Set this to your real domain once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
